{
  "$id": "https://dicom-standard-kb.local/schemas/tool_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "parseConfidence": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["high", "medium", "low", "unknown"],
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": ["array", "null"]
        },
        "source": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": ["level", "source"],
      "type": "object"
    },
    "responseClassification": {
      "additionalProperties": false,
      "properties": {
        "evidence_level": {
          "enum": [
            "parsed_table",
            "parsed_registry",
            "parsed_cross_reference",
            "retrieved_text",
            "external_comparison"
          ],
          "type": "string"
        },
        "machine_decidability": {
          "enum": [
            "decidable",
            "partially_decidable",
            "not_decidable",
            "not_applicable"
          ],
          "type": "string"
        },
        "normativity": {
          "enum": [
            "normative",
            "explanatory",
            "derived",
            "heuristic",
            "unsupported"
          ],
          "type": "string"
        }
      },
      "required": ["normativity", "evidence_level", "machine_decidability"],
      "type": "object"
    },
    "responseTrace": {
      "additionalProperties": false,
      "properties": {
        "query_id": {
          "format": "uuid",
          "type": "string"
        },
        "resolved_at": {
          "format": "date-time",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": ["string", "null"]
        }
      },
      "required": ["query_id", "resolved_at", "source_manifest_sha256"],
      "type": "object"
    },
    "standardRef": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": ["string", "null"]
        },
        "edition": {
          "minLength": 1,
          "type": "string"
        },
        "official_url": {
          "format": "uri",
          "type": ["string", "null"]
        },
        "part": {
          "minLength": 1,
          "type": "string"
        },
        "section": {
          "type": ["string", "null"]
        },
        "table": {
          "type": ["string", "null"]
        }
      },
      "required": ["part", "edition"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Common public envelope returned by CLI and future agent tools.",
  "properties": {
    "classification": {
      "$ref": "#/$defs/responseClassification"
    },
    "edition": {
      "minLength": 1,
      "type": "string"
    },
    "input": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "notice": {
      "const": "Consult the official DICOM Standard for authoritative text.",
      "type": "string"
    },
    "parse_confidence": {
      "$ref": "#/$defs/parseConfidence"
    },
    "refs": {
      "items": {
        "$ref": "#/$defs/standardRef"
      },
      "type": "array"
    },
    "result": {
      "type": ["object", "null"]
    },
    "status": {
      "enum": ["ok", "not_found", "validation_error"],
      "type": "string"
    },
    "tool": {
      "minLength": 1,
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/responseTrace"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "edition",
    "tool",
    "input",
    "status",
    "result",
    "classification",
    "parse_confidence",
    "refs",
    "warnings",
    "notice",
    "trace"
  ],
  "title": "ToolResponse",
  "type": "object"
}
